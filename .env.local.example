# Password for the /admin login form.
ADMIN_PASSWORD=

# GitHub personal access token with contents:read/write on the repo below
# (fine-grained PAT scoped to just this repo is recommended).
GITHUB_TOKEN=

# Repo the admin panel commits data/nurses.json and data/log.json to.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
